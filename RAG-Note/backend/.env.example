# Multilingual retrieval model (Nepali, Hindi, English + 90 more). Downloaded ONCE
# into backend/models/ and loaded offline afterwards.
HF_EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Better accuracy, bigger download (~1.1 GB):
# HF_EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Vision-language model that describes figures, charts and photos while indexing,
# and answers "Analyse images" questions. Downloaded once, on the first image only.
# Bigger = better but slower on CPU:  HuggingFaceTB/SmolVLM-500M-Instruct  or  Qwen/Qwen2-VL-2B-Instruct
HF_VLM_MODEL=HuggingFaceTB/SmolVLM-256M-Instruct
ENABLE_VLM=true
MAX_VLM_IMAGES_PER_DOC=25

# Optional LLM that rewrites the answer from the retrieved passages.
# Leave empty for 100% grounded extractive answers (recommended default).
# HF_QA_MODEL=Qwen/Qwen2.5-1.5B-Instruct
HF_QA_MODEL=

# ── Answer accuracy tuning (see README "How answers are decided") ──────────────
# The best-matching passage must stand out from the rest of your documents:
#   Z_STRONG  - stands out this much  => answer (works even across Nepali/English)
#   Z_MIN     - minimum when the question's own words also appear in the passage
# Raise them if you still get answers to questions the documents don't cover.
# Lower them if it says "not found" for questions that ARE covered.
Z_STRONG=3.0
Z_MIN=1.5
MIN_KEYWORD_COVERAGE=0.5
# A very short question matching several different places asks "which one?".
# Lower (0.7) = asks more often, higher (0.9) = asks less often.
AMBIG_RATIO=0.80
